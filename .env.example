# ==========================================
# STLForge Production Environment Variables
# ==========================================

# Application URL
NEXT_PUBLIC_APP_URL="https://stlforge.vercel.app"

# Database Configuration (PostgreSQL / Supabase with pooling)
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Authentication Configuration (NextAuth.js / Auth.js)
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="https://stlforge.vercel.app"
NEXTAUTH_URL="https://stlforge.vercel.app"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# Razorpay Standard Checkout & Orders API
# Merchant Profile: https://razorpay.me/@meiyarasan
RAZORPAY_KEY_ID="rzp_live_your_key_id"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret"
RAZORPAY_WEBHOOK_SECRET="your_webhook_signing_secret"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_live_your_key_id"
NEXT_PUBLIC_MERCHANT_PROFILE_URL="https://razorpay.me/@meiyarasan"

# Supabase Storage (Private digital files & public previews)
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
SUPABASE_STORAGE_BUCKET_PRIVATE="stl-files-private"
SUPABASE_STORAGE_BUCKET_PUBLIC="stl-images-public"

# Resend Transactional Email Delivery
RESEND_API_KEY="re_your_resend_api_key"
RESEND_FROM_EMAIL="STLForge Orders <orders@stlforge.com>"

# Default Administrator Seed Credentials
ADMIN_DEFAULT_EMAIL="admin@stlforge.com"
ADMIN_DEFAULT_PASSWORD="YourStrongAdminPassword2026!"
